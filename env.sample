# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nfl_app
# For MongoDB Atlas (replace with your connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nfl_app

# API Keys for external data sources
# Sportradar API for NFL schedule data
SPORTRADAR_API_KEY=your_sportradar_api_key_here

# RapidAPI for NFL news
RAPIDAPI_KEY=your_rapidapi_key_here

# Legacy API Keys (for future use)
NFL_API_KEY=your_nfl_api_key_here
NEWS_API_KEY=your_news_api_key_here

# External API URLs
NFL_API_BASE_URL=https://api.nfl.com/v1
NEWS_API_BASE_URL=https://newsapi.org/v2

# Security
JWT_SECRET=your_super_secret_jwt_key_here
API_RATE_LIMIT=100
ADMIN_TOKEN=mysecrettoken

# App Settings
DEFAULT_APP_VERSION=1.0.0
ENABLE_CRON_JOBS=true 